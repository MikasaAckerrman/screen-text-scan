<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      РАЗРЕШЕНИЯ И ЗАЧЕМ КАЖДОЕ

      SYSTEM_ALERT_WINDOW — единственный способ нарисовать плавающую кнопку
      поверх ЧУЖИХ приложений. Именно из-за него задача и не решалась из
      песочницы: обычному процессу такое окно создать нечем.
      Разрешение «особое»: его нельзя выдать диалогом, пользователь должен
      включить его в системных настройках — см. MainActivity.

      FOREGROUND_SERVICE (+ ..._SPECIAL_USE) — чтение идёт в сервисе, который
      живёт, пока пользователь листает чужое приложение. Без переднего плана
      система убьёт его через минуту.

      POST_NOTIFICATIONS — уведомление переднего сервиса обязательно с
      Android 13, иначе сервис не стартует.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Модель перевода скачивается один раз. Разрешение обычное, диалога не
      требует, но без него загрузка молча не пойдёт.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sts">

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Невидимый переходник для плитки. Панель быстрых настроек
          закрывается только как побочный эффект запуска АКТИВНОСТИ, а
          показывать экран не нужно — отсюда прозрачная тема без анимации
          и finish() сразу в onCreate.
          excludeFromRecents: в списке недавних ему делать нечего.
        -->
        <activity
            android:name=".LaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sts.Invisible" />

        <!--
          Экран результата: правка строк, исключение лишних, перевод.
          configChanges на поворот НЕ ставим специально: пусть система
          пересоздаёт экран, список перестроится из накопителя, а вот
          состояние правки в поле ввода при пересоздании потерялось бы —
          поэтому правка идёт в диалоге, который система сохраняет сама.
        -->
        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:label="Прочитанный текст"
            android:theme="@style/Theme.Sts" />

        <!--
          Служба доступности — источник текста. Она НЕ распознаёт картинку:
          читает строки из дерева элементов приложения, поэтому текст
          получается точным, а один опрос стоит около 50 мс.

          Доступность остаётся системным разрешением и переживает обычное
          закрытие приложения. За удержание процесса на OriginOS отвечает
          отдельный AccessibilityKeepAliveService ниже.
        -->
        <service
            android:name=".ScanAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!--
          OriginOS может остановить accessibility-службу при удалении карточки
          приложения из последних задач. Этот тихий sticky foreground-service
          удерживает процесс, пока доступность включена пользователем.
        -->
        <service
            android:name=".AccessibilityKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Удержание включённой пользователем службы доступности" />
        </service>

        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Плитка в панели быстрых настроек: то, чем это запускается. -->
        <service
            android:name=".ScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Плавающая кнопка + накопление текста.

          Про поворот экрана: атрибут configChanges сервисам не нужен и не
          применяется — Service.onConfigurationChanged система вызывает
          всегда, при любом изменении конфигурации. Пересчёт зоны и позиции
          кнопки сделан там.
        -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Чтение текста с экрана по запросу пользователя" />
        </service>
    </application>
</manifest>
